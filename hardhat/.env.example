# ---------------------------------------------------------------------------
# Hardhat deployment environment — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real private keys.
# ---------------------------------------------------------------------------

# Deployer private key for the Ritual Chain network (chainId 1979).
# 0x-prefixed 32-byte hex. The matching account must hold RITUAL for gas.
# Used by the `ritual` network in hardhat.config.ts.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: only needed if you also deploy to Sepolia.
SEPOLIA_RPC_URL=https://sepolia.example/your-key
SEPOLIA_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY_HERE
